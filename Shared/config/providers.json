{
  "providers": [
    {
      "id": "venice",
      "name": "Venice AI",
      "base_url": "https://api.venice.ai/api/v1",
      "api_key_env": "VENICE_API_KEY",
      "openai_compatible": true,
      "fetch_models": true,
      "include_system_prompt": false,
      "context_limit_fallback": "kilocode",
      "capabilities": ["chat", "code", "vision", "reasoning", "uncensored"],
      "auth": "bearer",
      "note": "~242 models including Claude 4.5, Codex 5.5, open-source. System prompt fully controlled. include_venice_system_prompt always set to false."
    },
    {
      "id": "kilocode",
      "name": "KiloCode",
      "base_url": "https://api.kilocode.ai/v1",
      "api_key_env": "KILOCODE_API_KEY",
      "openai_compatible": true,
      "fetch_models": true,
      "include_system_prompt": false,
      "session_continuity": true,
      "context_limit_fallback": null,
      "capabilities": ["chat", "code", "vision", "reasoning"],
      "auth": "bearer",
      "note": "Identical model pool to Venice. Used for session continuity when Venice context limit is reached. Same underlying infrastructure — seamless handoff with full message history preserved."
    },
    {
      "id": "anthropic",
